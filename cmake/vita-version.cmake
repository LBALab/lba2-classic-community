function(lba2_vita_package_version engine_version output)
    if(NOT engine_version MATCHES "^([0-9]+)\\.([0-9]+)\\.[0-9]+([-+][0-9A-Za-z.+-]+)?$")
        message(FATAL_ERROR "Invalid engine version for Vita packaging: '${engine_version}'.")
    endif()
    set(major "${CMAKE_MATCH_1}")
    set(minor "${CMAKE_MATCH_2}")
    foreach(part major minor)
        string(LENGTH "${${part}}" length)
        if(length GREATER 2)
            message(FATAL_ERROR "Vita package major and minor must each fit in two digits: '${engine_version}'.")
        endif()
        if(length EQUAL 1)
            set(${part} "0${${part}}")
        endif()
    endforeach()
    set(${output} "${major}.${minor}" PARENT_SCOPE)
endfunction()

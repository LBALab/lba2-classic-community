function(lba2_read_input_actions header)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${header}")
    file(STRINGS "${header}" lines)
    set(names "")
    set(slots "")
    foreach(line IN LISTS lines)
        if(NOT line MATCHES "^[ \t]*#[ \t]*define[ \t]+INPUT_SLOT_")
            continue()
        endif()
        if(NOT line MATCHES "^#define INPUT_SLOT_([A-Z][A-Z0-9_]*) (-1|0|[1-9][0-9]*)$")
            message(FATAL_ERROR "Input action declarations must be #define INPUT_SLOT_NAME integer: ${line}")
        endif()
        set(name "${CMAKE_MATCH_1}")
        set(slot "${CMAKE_MATCH_2}")
        if(name IN_LIST names OR slot IN_LIST slots)
            message(FATAL_ERROR "Duplicate input action name or slot: ${name}, ${slot}")
        endif()
        if((name STREQUAL "NONE" AND NOT slot EQUAL -1) OR
           (NOT name STREQUAL "NONE" AND (slot LESS 0 OR slot GREATER 35)))
            message(FATAL_ERROR "Input action NONE must be -1; binding slots must be in 0..35")
        endif()
        list(APPEND names "${name}")
        list(APPEND slots "${slot}")
        set(action_${slot} "${name}")
        set(INPUT_SLOT_${name} "${slot}" PARENT_SCOPE)
    endforeach()
    list(LENGTH names count)
    if(NOT count EQUAL 37 OR NOT "NONE" IN_LIST names OR
       NOT "PINGOUIN" IN_LIST names OR NOT "FOUDRE" IN_LIST names)
        message(FATAL_ERROR "Input actions must declare NONE and all 36 binding slots")
    endif()
    set(actions "")
    foreach(slot RANGE 0 35)
        if(NOT DEFINED action_${slot})
            message(FATAL_ERROR "Missing input action slot: ${slot}")
        endif()
        list(APPEND actions "${action_${slot}}")
    endforeach()
    if(NOT action_32 STREQUAL "PINGOUIN" OR NOT action_35 STREQUAL "FOUDRE")
        message(FATAL_ERROR "Input2 must start at PINGOUIN and end at FOUDRE")
    endif()
    set(INPUT_ACTIONS "${actions}" PARENT_SCOPE)
endfunction()

function(lba2_input_action_slot action allow_none input_word_only output)
    if(NOT action MATCHES "^[A-Z][A-Z0-9_]*$" OR
       (NOT action IN_LIST INPUT_ACTIONS AND NOT action STREQUAL "NONE"))
        message(FATAL_ERROR "Unknown input profile action: ${action}")
    endif()
    if(action STREQUAL "NONE" AND NOT allow_none)
        message(FATAL_ERROR "Input profile NONE is only valid for disabled touch actions")
    endif()
    set(slot "${INPUT_SLOT_${action}}")
    if(input_word_only AND slot GREATER_EQUAL INPUT_SLOT_PINGOUIN)
        message(FATAL_ERROR "Input profile action ${action} belongs to Input2, not Input")
    endif()
    set(${output} "${slot}" PARENT_SCOPE)
endfunction()

function(input_touch_button kind key label cx cy rx ry)
    if(NOT kind MATCHES "^(KEY|HIDE)$" OR NOT key MATCHES "^(0|K_[A-Z0-9_]+)$" OR
       NOT label MATCHES "^[A-Za-z0-9 ]+$")
        message(FATAL_ERROR "Invalid input profile touch button: ${kind}, ${key}, ${label}")
    endif()
    foreach(value cx cy rx ry)
        if(NOT "${${value}}" MATCHES "^[0-9]+\\.[0-9]+$" OR ${value} LESS 0 OR ${value} GREATER 1)
            message(FATAL_ERROR "Input profile touch geometry must be in 0.0..1.0")
        endif()
    endforeach()
    if(rx EQUAL 0 OR ry EQUAL 0)
        message(FATAL_ERROR "Input profile touch button radius must be positive")
    endif()
    set(hide 0)
    if(kind STREQUAL "HIDE")
        if(NOT key STREQUAL "0")
            message(FATAL_ERROR "Input profile HIDE button cannot inject a key")
        endif()
        set(hide 1)
    endif()
    set(INPUT_TOUCH_ROWS "${INPUT_TOUCH_ROWS}{${hide}, \"${label}\", ${cx}f, ${cy}f, ${rx}f, ${ry}f, ${key}}, " PARENT_SCOPE)
endfunction()

function(lba2_configure_input_profile profile output_dir)
    lba2_read_input_actions("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../SOURCES/INPUT_ACTIONS.H")
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/input/default.cmake")
    get_filename_component(profile "${profile}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
    if(NOT EXISTS "${profile}")
        message(FATAL_ERROR "Input profile does not exist: ${profile}")
    endif()
    include("${profile}")

    get_cmake_property(variables VARIABLES)
    foreach(variable IN LISTS variables)
        if(variable MATCHES "^INPUT_(KEYBOARD|GAMEPAD)_(.+)$")
            lba2_input_action_slot("${CMAKE_MATCH_2}" FALSE FALSE slot)
        endif()
    endforeach()
    if(NOT INPUT_DEADZONE MATCHES "^[0-9]+$" OR INPUT_DEADZONE GREATER 32767)
        message(FATAL_ERROR "Input profile deadzone must be in 0..32767")
    endif()
    foreach(source DIRECT INDIRECT)
        if(DEFINED INPUT_${source}_TOUCH_SLOT)
            message(FATAL_ERROR "Input profile uses INPUT_${source}_TOUCH_ACTION, not numeric touch slots")
        endif()
        lba2_input_action_slot("${INPUT_${source}_TOUCH_ACTION}" TRUE TRUE INPUT_${source}_TOUCH_SLOT)
    endforeach()
    if(NOT INPUT_OVERLAY_TOUCH_SOURCE MATCHES "^(direct|indirect|both)$")
        message(FATAL_ERROR "Input profile overlay source must be direct, indirect or both")
    endif()
    set(INPUT_OVERLAY_DIRECT 0)
    set(INPUT_OVERLAY_INDIRECT 0)
    if(NOT INPUT_OVERLAY_TOUCH_SOURCE STREQUAL "indirect")
        set(INPUT_OVERLAY_DIRECT 1)
    endif()
    if(NOT INPUT_OVERLAY_TOUCH_SOURCE STREQUAL "direct")
        set(INPUT_OVERLAY_INDIRECT 1)
    endif()
    if(INPUT_TOUCH_ROWS AND
       ((INPUT_DIRECT_TOUCH_SLOT GREATER_EQUAL 0 AND INPUT_OVERLAY_DIRECT) OR
        (INPUT_INDIRECT_TOUCH_SLOT GREATER_EQUAL 0 AND INPUT_OVERLAY_INDIRECT)))
        message(FATAL_ERROR "Input profile touch source cannot use both tap actions and overlay buttons")
    endif()
    foreach(device KEYBOARD GAMEPAD)
        set(INPUT_${device}_ROWS "")
        foreach(action IN LISTS INPUT_ACTIONS)
            list(LENGTH INPUT_${device}_${action} count)
            if(NOT count EQUAL 2)
                message(FATAL_ERROR "Input profile ${device} action ${action} must have two keys")
            endif()
            foreach(key IN LISTS INPUT_${device}_${action})
                if(NOT key MATCHES "^(0|K_[A-Z0-9_]+)$")
                    message(FATAL_ERROR "Invalid input profile key: ${key}")
                endif()
            endforeach()
            list(GET INPUT_${device}_${action} 0 primary)
            list(GET INPUT_${device}_${action} 1 alternate)
            string(APPEND INPUT_${device}_ROWS "{${primary}, ${alternate}}, ")
        endforeach()
    endforeach()

    set(INPUT_MODAL_ROWS "")
    set(seen "")
    list(LENGTH INPUT_MODAL_REMAPS remap_count)
    if(remap_count GREATER 32)
        message(FATAL_ERROR "Input profile supports at most 32 modal remaps")
    endif()
    foreach(remap IN LISTS INPUT_MODAL_REMAPS)
        if(NOT remap MATCHES "^(K_[A-Z0-9_]+),([A-Z][A-Z0-9_]*),([A-Z][A-Z0-9_]*)$")
            message(FATAL_ERROR "Input profile modal remap must be KEY,gameplay_action,modal_action: ${remap}")
        endif()
        set(key "${CMAKE_MATCH_1}")
        set(source_action "${CMAKE_MATCH_2}")
        set(destination_action "${CMAKE_MATCH_3}")
        lba2_input_action_slot("${source_action}" FALSE TRUE source)
        lba2_input_action_slot("${destination_action}" FALSE TRUE destination)
        if("${key},${source}" IN_LIST seen)
            message(FATAL_ERROR "Duplicate input profile modal remap: ${key},${source}")
        endif()
        list(APPEND seen "${key},${source}")
        string(APPEND INPUT_MODAL_ROWS "{${key}, ${source}, ${destination}}, ")
    endforeach()
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/input-profile.h.in"
        "${output_dir}/INPUT_PROFILE_CONFIG.H" @ONLY)
endfunction()

function(lba2_target_input_profile target profile)
    set(output_dir "${CMAKE_CURRENT_BINARY_DIR}/${target}-input")
    lba2_configure_input_profile("${profile}" "${output_dir}")
    target_include_directories(${target} BEFORE PRIVATE "${output_dir}")
endfunction()

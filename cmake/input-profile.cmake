function(input_touch_button kind key label cx cy rx ry)
    if(NOT kind MATCHES "^(KEY|HIDE)$" OR NOT key MATCHES "^(0|K_[A-Z0-9_]+)$" OR
       NOT label MATCHES "^[A-Za-z0-9 ]+$")
        message(FATAL_ERROR "Invalid input profile touch button: ${kind}, ${key}, ${label}")
    endif()
    foreach(value cx cy rx ry)
        if(NOT "${${value}}" MATCHES "^[0-9]+\\.[0-9]+$" OR ${value} LESS 0 OR ${value} GREATER 1)
            message(FATAL_ERROR "Input profile touch geometry must be in 0.0..1.0")
        endif()
    endforeach()
    if(rx EQUAL 0 OR ry EQUAL 0)
        message(FATAL_ERROR "Input profile touch button radius must be positive")
    endif()
    set(hide 0)
    if(kind STREQUAL "HIDE")
        if(NOT key STREQUAL "0")
            message(FATAL_ERROR "Input profile HIDE button cannot inject a key")
        endif()
        set(hide 1)
    endif()
    set(INPUT_TOUCH_ROWS "${INPUT_TOUCH_ROWS}{${hide}, \"${label}\", ${cx}f, ${cy}f, ${rx}f, ${ry}f, ${key}}, " PARENT_SCOPE)
endfunction()

function(lba2_configure_input_profile profile output_dir)
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/input/default.cmake")
    get_filename_component(profile "${profile}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
    if(NOT EXISTS "${profile}")
        message(FATAL_ERROR "Input profile does not exist: ${profile}")
    endif()
    include("${profile}")

    if(NOT INPUT_DEADZONE MATCHES "^[0-9]+$" OR INPUT_DEADZONE GREATER 32767)
        message(FATAL_ERROR "Input profile deadzone must be in 0..32767")
    endif()
    foreach(source DIRECT INDIRECT)
        if(NOT INPUT_${source}_TOUCH_SLOT MATCHES "^(-1|[0-9]+)$" OR INPUT_${source}_TOUCH_SLOT GREATER 31)
            message(FATAL_ERROR "Input profile ${source}-touch slot must be -1 or in 0..31")
        endif()
    endforeach()
    if(NOT INPUT_OVERLAY_TOUCH_SOURCE MATCHES "^(direct|indirect|both)$")
        message(FATAL_ERROR "Input profile overlay source must be direct, indirect or both")
    endif()
    set(INPUT_OVERLAY_DIRECT 0)
    set(INPUT_OVERLAY_INDIRECT 0)
    if(NOT INPUT_OVERLAY_TOUCH_SOURCE STREQUAL "indirect")
        set(INPUT_OVERLAY_DIRECT 1)
    endif()
    if(NOT INPUT_OVERLAY_TOUCH_SOURCE STREQUAL "direct")
        set(INPUT_OVERLAY_INDIRECT 1)
    endif()
    if(INPUT_TOUCH_ROWS AND
       ((INPUT_DIRECT_TOUCH_SLOT GREATER_EQUAL 0 AND INPUT_OVERLAY_DIRECT) OR
        (INPUT_INDIRECT_TOUCH_SLOT GREATER_EQUAL 0 AND INPUT_OVERLAY_INDIRECT)))
        message(FATAL_ERROR "Input profile touch source cannot use both tap actions and overlay buttons")
    endif()
    foreach(device KEYBOARD GAMEPAD)
        set(INPUT_${device}_ROWS "")
        foreach(slot RANGE 0 35)
            list(LENGTH INPUT_${device}_${slot} count)
            if(NOT count EQUAL 2)
                message(FATAL_ERROR "Input profile ${device} slot ${slot} must have two keys")
            endif()
            foreach(key IN LISTS INPUT_${device}_${slot})
                if(NOT key MATCHES "^(0|K_[A-Z0-9_]+)$")
                    message(FATAL_ERROR "Invalid input profile key: ${key}")
                endif()
            endforeach()
            list(GET INPUT_${device}_${slot} 0 primary)
            list(GET INPUT_${device}_${slot} 1 alternate)
            string(APPEND INPUT_${device}_ROWS "{${primary}, ${alternate}}, ")
        endforeach()
    endforeach()

    set(INPUT_MODAL_ROWS "")
    set(seen "")
    list(LENGTH INPUT_MODAL_REMAPS remap_count)
    if(remap_count GREATER 32)
        message(FATAL_ERROR "Input profile supports at most 32 modal remaps")
    endif()
    foreach(remap IN LISTS INPUT_MODAL_REMAPS)
        if(NOT remap MATCHES "^(K_[A-Z0-9_]+),([0-9]+),([0-9]+)$")
            message(FATAL_ERROR "Input profile modal remap must be KEY,gameplay_slot,modal_slot: ${remap}")
        endif()
        set(key "${CMAKE_MATCH_1}")
        set(source "${CMAKE_MATCH_2}")
        set(destination "${CMAKE_MATCH_3}")
        if(source GREATER 31 OR destination GREATER 31)
            message(FATAL_ERROR "Input profile modal remap slots must be in 0..31")
        endif()
        if("${key},${source}" IN_LIST seen)
            message(FATAL_ERROR "Duplicate input profile modal remap: ${key},${source}")
        endif()
        list(APPEND seen "${key},${source}")
        string(APPEND INPUT_MODAL_ROWS "{${key}, ${source}, ${destination}}, ")
    endforeach()
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/input-profile.h.in"
        "${output_dir}/INPUT_PROFILE_CONFIG.H" @ONLY)
endfunction()

function(lba2_target_input_profile target profile)
    set(output_dir "${CMAKE_CURRENT_BINARY_DIR}/${target}-input")
    lba2_configure_input_profile("${profile}" "${output_dir}")
    target_include_directories(${target} BEFORE PRIVATE "${output_dir}")
endfunction()

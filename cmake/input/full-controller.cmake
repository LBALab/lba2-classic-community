set(INPUT_DEADZONE 8000)
# Slots follow INPUT_BINDINGS.H. Each pair is primary / alternate physical key.
set(INPUT_GAMEPAD_0 K_GAMEPAD_RTRIGGER 0)
set(INPUT_GAMEPAD_1 K_GAMEPAD_LTRIGGER 0)
set(INPUT_GAMEPAD_2 K_GAMEPAD_LSTICK_LEFT 0)
set(INPUT_GAMEPAD_3 K_GAMEPAD_LSTICK_RIGHT 0)
set(INPUT_GAMEPAD_4 K_GAMEPAD_RSHOULDER 0)
set(INPUT_GAMEPAD_5 K_GAMEPAD_LSHOULDER 0)
set(INPUT_GAMEPAD_6 K_GAMEPAD_Y 0)
set(INPUT_GAMEPAD_7 K_GAMEPAD_X 0)
set(INPUT_GAMEPAD_8 K_GAMEPAD_A 0)
set(INPUT_GAMEPAD_9 K_GAMEPAD_B 0)
set(INPUT_GAMEPAD_10 K_GAMEPAD_START 0)
set(INPUT_GAMEPAD_11 K_GAMEPAD_BACK 0)

set(INPUT_GAMEPAD_24 K_GAMEPAD_RSTICK_DOWN 0)
foreach(slot RANGE 25 31)
    set(INPUT_GAMEPAD_${slot} 0 0)
endforeach()
set(INPUT_GAMEPAD_32 K_GAMEPAD_DPAD_RIGHT 0)
set(INPUT_GAMEPAD_33 K_GAMEPAD_DPAD_DOWN 0)
set(INPUT_GAMEPAD_34 K_GAMEPAD_DPAD_UP 0)
set(INPUT_GAMEPAD_35 K_GAMEPAD_DPAD_LEFT 0)

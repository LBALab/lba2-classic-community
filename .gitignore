/cmake-build-*
/.idea/
CMakeUserPresets.json
out/
build/
# Demo SKU: a separate configure, so a second tree beside build/ (GAME_DATA.md)
build-demo/
# AddressSanitizer host tests: linux_sanitize is a different build type again
build-asan/
# Second front end: linux_clang, kept beside build/ so both stay warm
build-clang/
# Throwaway tree for scripts/ci/warning-baseline.sh (always a clean rebuild)
build-warnings/
dist/

# Local retail drop (symlink or copy classic data here; never commit assets)
/data/
# Scratch dir for CD-image / HQR / ACF exploration (extracted assets — never commit)
/.tc-scratch/
/build_test
/build_logs/
.tmp/

# lychee --cache writes this; useful locally, never worth committing
.lycheecache

# Python (e.g. scripts/save_probe.py)
__pycache__/
*.py[cod]
*$py.class

# Polyrec rendered outputs (keep .lba2polyrec fixtures, ignore generated images)
tests/SNAPSHOT/fixtures/*.png
tests/SNAPSHOT/fixtures/*.ppm
tests/SNAPSHOT/fixtures/*.raw

# Android build outputs
android/build/
android/apk/
android/local.properties
